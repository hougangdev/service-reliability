# Database (required for app and worker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_monitor

# Poller (optional; defaults shown)
POLL_INTERVAL_MS=30000
CHECK_TIMEOUT_MS=3000
CONCURRENCY_LIMIT=10

# Alerting (optional)
ALERT_WEBHOOK_URL=
ALERT_THRESHOLD=3

# Retention (optional; defaults shown)
RETENTION_DAYS=7
MAX_CHECKS_PER_SERVICE=500

# AI Incident Summary (optional — stretch goal)
ANTHROPIC_API_KEY=

# Node
NODE_ENV=development
